---
// src/components/VerticalCard.astro
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
---

<div class="card bg-base-100 shadow-lg hover:shadow-2xl transition ease-in-out hover:scale-[102%] border border-base-200 overflow-hidden flex flex-col h-full">
  <a href={url} target={target} class="flex flex-col h-full">
    
    {img && (
      <figure class="w-full h-48 overflow-hidden">
        <Image
          src={img}
          width={750}
          height={422}
          format="webp"
          alt={title}
          class="w-full h-full object-cover"
        />
      </figure>
    )}

    <div class="card-body p-6 flex-grow">
      <h2 class="card-title text-xl font-bold leading-tight">
        {title}
      </h2>
      
      {badge && (
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-secondary">{badge}</span>
        </div>
      )}
      
      <p class="text-sm opacity-90 mt-2">{desc}</p>
      
      {tags && (
        <div class="card-actions justify-end mt-4">
          {tags.map((tag) => <div class="badge badge-outline">{tag}</div>)}
        </div>
      )}
    </div>
  </a>
</div>