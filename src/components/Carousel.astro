---
// src/components/Carousel.astro
const { title } = Astro.props;
// Generates a unique ID so the arrows know exactly which carousel to scroll
const carouselId = "carousel-" + Math.random().toString(36).substring(2, 11);
---
<div class="mb-14 w-full">
  <h2 class="text-3xl font-bold mb-6 border-b border-base-300 pb-2">{title}</h2>
  
  <div class="relative group">
    
    <button 
      aria-label="Scroll Left"
      onclick={`document.getElementById('${carouselId}').scrollBy({ left: -550, behavior: 'smooth' })`} 
      class="absolute -left-5 top-1/2 -translate-y-1/2 z-10 btn btn-circle bg-base-100 border-base-300 opacity-0 group-hover:opacity-100 transition-opacity shadow-md hidden sm:flex items-center justify-center hover:bg-base-300"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
    </button>

    <div 
      id={carouselId} 
      class="grid grid-rows-2 grid-flow-col auto-cols-max gap-x-6 gap-y-4 overflow-x-auto overflow-y-hidden w-full p-4 bg-base-200 rounded-2xl shadow-inner snap-x snap-mandatory hide-scrollbar items-stretch"
    >
      <slot />
    </div>

    <button 
      aria-label="Scroll Right"
      onclick={`document.getElementById('${carouselId}').scrollBy({ left: 550, behavior: 'smooth' })`} 
      class="absolute -right-5 top-1/2 -translate-y-1/2 z-10 btn btn-circle bg-base-100 border-base-300 opacity-0 group-hover:opacity-100 transition-opacity shadow-md hidden sm:flex items-center justify-center hover:bg-base-300"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
    </button>

  </div>
</div>

<style>
  /* Hides the ugly default browser scrollbar */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  /* Forces the Astrofy HorizontalCard to expand to full height of the grid cell */
  :global(.carousel-item-wrapper) {
    height: 100%;
  }
  :global(.carousel-item-wrapper > div > a),
  :global(.carousel-item-wrapper > div > div) {
    height: 100% !important;
    display: flex;
    flex-direction: column;
  }
</style>