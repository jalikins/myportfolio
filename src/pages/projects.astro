---
import BaseLayout from "../layouts/BaseLayout.astro";
import VerticalCard from "../components/VerticalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects" fullWidth={true}>
  <div class="mb-10">
    <h1 class="text-4xl font-bold">Engineering Portfolio</h1>
  </div>

  <div class="mb-14">
    <h2 class="text-3xl font-bold mb-6 border-b border-base-300 pb-2">Formula SAE & Vehicle Integration</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <VerticalCard
        title="FSAE Hardware Architecture"
        img="/hardware/giant_block.png"
        desc="Designed and routed custom PCBs for critical electric vehicle subsystems, including the BMS, throttle, and high-voltage precharge circuits."
        url="/project/FSAE_hardware"
        badge="PCB, High-Voltage, KiCad"
      />
      <VerticalCard
        title="FSAE Firmware Monorepo"
        img="/pcb/service_section.png"
        desc="Architected a Bazel-based monorepo to unify firmware development, automated CAN code generation, and PCB design."
        url="/project/FSAE_firmware"
        badge="Embedded, Python, CI/CD"
      />
      <VerticalCard
        title="Electrical Lead Olin Electric Motorsports"
        img="/leadership/team.jpg"
        desc="Co-directed a 20-person electrical engineering team, overseeing firmware architecture, hardware design reviews, and cross-functional integration."
        url="/project/FSAE_leadership"
        badge="Leadership, Project Management"
      />
    </div>
  </div>

  <div class="mb-14">
    <h2 class="text-3xl font-bold mb-6 border-b border-base-300 pb-2">Robotics & Embedded Systems</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <VerticalCard
        title="RISC32I Processor FPGA"
        img="/risc/simulation.png"
        desc="Designed a custom multicycle RISC-V processor architecture in SystemVerilog, deployed to an FPGA."
        url="/project/riskv"
        badge="Computer Architecture"
      />
      <VerticalCard
        title="Automated Resistor Sorter"
        img="/post_img.webp"
        desc="Designed custom PCB and electromechanical control systems for an automated resistor sorting machine."
        url="/project/Resistor_sorter"
        badge="Mechatronics"
      />
      <VerticalCard
        title="Clemson Robotics Research"
        img="/clemson/final_image.png"
        desc="Modeled autonomous systems and evaluated intelligent control environments utilizing pathfinding algorithms in NVIDIA Isaac Sim."
        url="/project/Clemson_internship"
        badge="Research"
      />
      <VerticalCard
        title="3D Scanner Project"
        img="/3d_scanner/3d_scanner_white_bg.png"
        desc="Developed a structured-light 3D scanning system, including hardware calibration and point-cloud processing."
        url="/project/3d_scanner"
        badge="Computer Vision"
      />
    </div>
  </div>

  <div class="mb-14">
    <h2 class="text-3xl font-bold mb-6 border-b border-base-300 pb-2">Software & Web Tools</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <VerticalCard
        title="Web Design Portfolio"
        img="/website/home_page.png"
        desc="Customized an Astro-based portfolio site with optimized responsive layouts and 3D model integration."
        url="/project/Web_design"
        badge="Web Dev"
      />
      <VerticalCard
        title="Type Race Game"
        img="/itemPreview.webp"
        desc="Built a fast-paced typing racing game with real-time stat tracking."
        url="/project/type_race"
        badge="Software"
      />
    </div>
  </div>
</BaseLayout>