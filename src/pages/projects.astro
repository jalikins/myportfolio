---
import BaseLayout from "../layouts/BaseLayout.astro";
import VerticalCard from "../components/VerticalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects" fullWidth={true}>
  <div class="mb-10">
    <h1 class="text-4xl font-bold">Engineering Portfolio</h1>
  </div>

  <div class="mb-14">
    <h2 class="text-3xl font-bold mb-6 border-b border-base-300 pb-2">Favorites</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <VerticalCard
        title="Asensus Surgical Internship"
        img="/leadership/team.jpg"
        desc="Electrical engineering intern at Asensus Surgical. Worked on designing and testing PCBs and implementing firmware into system"
        url="/project/asensus-surgical-internship"
        badge="Design, Safety, Embedded"
      />
      <VerticalCard
        title="FSAE Firmware Monorepo"
        img="/monorepo/big_block.png"
        desc="Architected a Bazel-based monorepo to unify firmware development, automated CAN code generation, and PCB design."
        url="/project/fsae-firmware-monorepo"
        badge="Embedded, Python, CI/CD"
      />
      <VerticalCard
        title="FSAE Hardware Architecture"
        img="/hardware/giant_block.png"
        desc="Designed and routed custom PCBs for critical electric vehicle subsystems, including the BMS, throttle, and high-voltage precharge circuits."
        url="/project/fsae-hardware"
        badge="PCB, High-Voltage, KiCad"
      />
  </div>

  <div class="mb-14">
    <h2 class="text-3xl font-bold mb-6 border-b border-base-300 pb-2">Software</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <VerticalCard
        title="RISC32I Processor FPGA"
        img="/risc/simulation.png"
        desc="Designed a custom multicycle RISC-V processor architecture in SystemVerilog, deployed to an FPGA."
        url="/project/risc32-processor-with-fpga-implementation"
        badge="Computer Architecture"
      />
      <VerticalCard
        title="FSAE Firmware Monorepo"
        img="/monorepo/big_block.png"
        desc="Architected a Bazel-based monorepo to unify firmware development, automated CAN code generation, and PCB design."
        url="/project/fsae-firmware-monorepo"
        badge="Embedded, Python, CI/CD"
      />
      <VerticalCard
        title="Web Design Portfolio"
        img="/website/home_page.png"
        desc="Customized an Astro-based portfolio site with optimized responsive layouts and 3D model integration."
        url="/project/contractor-portfolio-platform"
        badge="Web Dev"
      />
      <VerticalCard
        title="Type Race Game"
        img="/itemPreview.webp"
        desc="Built a fast-paced typing racing game with real-time stat tracking."
        url="/project/type-race-application"
        badge="Software"
      />
      <VerticalCard
        title="Line Following Robot"
        img="/line_follower/robot.jpg"
        desc="Designed and built a line-following robot using Arduino and sensors."
        url="/project/autonomous-line-following-robot"
        badge="Embedded, C++"
      />
      
    </div>
  </div>

  <div class="mb-14">
    <h2 class="text-3xl font-bold mb-6 border-b border-base-300 pb-2">Hardware</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <VerticalCard
        title="FSAE Hardware Architecture"
        img="/hardware/giant_block.png"
        desc="Designed and routed custom PCBs for critical electric vehicle subsystems, including the BMS, throttle, and high-voltage precharge circuits."
        url="/project/fsae-hardware"
        badge="PCB, High-Voltage, KiCad"
      />
      <VerticalCard
        title="Automated Resistor Sorter"
        img="/sorter/system.png"
        desc="Designed custom PCB and electromechanical control systems for an automated resistor sorting machine."
        url="/project/automated-resistor-sorter"
        badge="Mechatronics"
      />
      <VerticalCard
        title="Clemson Robotics Research"
        img="/clemson/final_image.png"
        desc="Modeled autonomous systems and evaluated intelligent control environments utilizing pathfinding algorithms in NVIDIA Isaac Sim."
        url="/project/autonomous-robotic-simulation"
        badge="Research"
      />
      <VerticalCard
        title="3D Scanner Project"
        img="/3d_scanner/3d_scanner_white_bg.png"
        desc="Developed a structured-light 3D scanning system, including hardware calibration and point-cloud processing."
        url="/project/automated-3d-spatial-scanner"
        badge="Computer Vision"
      />
    </div>
  </div>

  <div class="mb-14">
    <h2 class="text-3xl font-bold mb-6 border-b border-base-300 pb-2">Miscellaneous</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <VerticalCard
        title="Electrical Lead Olin Electric Motorsports"
        img="/leadership/team.jpg"
        desc="Co-directed a 20-person electrical engineering team, overseeing firmware architecture, hardware design reviews, and cross-functional integration."
        url="/project/electrical-and-firmware-lead-olin-electric-motorsports"
        badge="Leadership, Project Management"
      />
      <VerticalCard
        title="Remote Controlled Golf Cart"
        img="/golfcart/full_golfcart.jpg"
        desc="Worked with team to have a remote controlled golf cart."
        url="/project/remote-controlled-golf-cart"
        badge="Prototyping, Control Systems, C++"
      />
      <VerticalCard
        title="Asensus Surgical Internship"
        img="/leadership/team.jpg"
        desc="Electrical engineering intern at Asensus Surgical. Worked on designing and testing PCBs and implementing firmware into system"
        url="/project/asensus-surgical-internship"
        badge="Design, Safety, Embedded"
      />
    </div>
  </div>
</BaseLayout>