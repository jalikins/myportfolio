---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">

  <div>
    <div class="text-3xl w-full font-bold mb-5">Formula SAE Engineering</div>
  </div>

  <HorizontalCard
    title="FSAE High-Voltage Hardware Architecture"
    img="/pcb/bms.png"
    desc="Designed and integrated custom KiCad PCBs for critical electric vehicle subsystems, including the BMS, throttle, and precharge circuits."
    url="/project/fsae-high-voltage-hardware-architecture"
    badge="Hardware Lead"
  />
  <div class="divider my-0"></div>
  
  <HorizontalCard
    title="FSAE Firmware Monorepo Integration"
    img="/pcb/service_section.png"
    desc="Led the firmware transition to an STM32G4 architecture and developed a custom CAN bootloader for rapid vehicle flashing."
    url="/project/fsae-firmware-monorepo-integration"
    badge="Embedded Systems"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Electrical Lead Olin Electric Motorsports"
    img="/profile.webp"
    desc="Directed a 20-person engineering team to design, review, and integrate the electrical systems for a competitive Formula SAE vehicle."
    url="/project/electrical-lead-olin-electric-motorsports"
    badge="Leadership"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Professional & Academic Research</div>
  </div>

  <HorizontalCard
    title="Surgical Robotics Engineering"
    img="/post_img.webp"
    desc="Contributing to advanced medical robotics and electrical engineering initiatives in a professional clinical technology environment."
    url="/project/surgical-robotics-engineering"
    badge="Asensus Surgical"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Autonomous Robotic Simulation"
    img="/clemson/cad_image.png"
    desc="Modeled autonomous systems and evaluated intelligent control environments utilizing pathfinding algorithms in Isaac Sim."
    url="/project/autonomous-robotic-simulation"
    badge="Clemson University"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Hardware & Prototyping</div>
  </div>

  <HorizontalCard
    title="Automated 3D Spatial Scanner"
    img="/post_img.webp"
    desc="Engineered a custom camera movement system and programmed automated spatial data plotting using MATLAB."
    url="/project/automated-3d-spatial-scanner"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="RISC32I Processor FPGA Implementation"
    img="/post_img.webp"
    desc="Designed and implemented a custom RISC-V architecture and memory data representation on FPGA hardware."
    url="/project/risc32i-processor-fpga-implementation"
    badge="Computer Architecture"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Automated Resistor Sorter"
    img="/post_img.webp"
    desc="Collaborated on a 6-person team to design a custom PCB for component sorting, documenting rapid iteration and hardware debugging processes."
    url="/project/automated-resistor-sorter"
    badge="PCB Design"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Autonomous Line-Following Robot"
    img="/post_img.webp"
    desc="Developed a responsive robotics platform utilizing custom sensor integration and control logic for autonomous navigation."
    url="/project/autonomous-line-following-robot"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Remote-Controlled Vehicle Conversion"
    img="/golfcart/full_golfcart.jpg"
    desc="Engineered custom motherboards and mapped power distribution to convert a standard golf cart into a remote-operated vehicle."
    url="/project/remote-controlled-vehicle-conversion"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Software & Web Development</div>
  </div>

  <HorizontalCard
    title="Type Race Application"
    img="/itemPreview.webp"
    desc="Developed a responsive typing speed application focusing on real-time input validation, asynchronous networking, and performance tracking."
    url="/project/type-race-application"
    badge="Python / Sockets"
  />
  <div class="divider my-0"></div>

  <HorizontalCard
    title="Contractor Portfolio Platform"
    img="/website/home_page.png"
    desc="Designed and deployed a high-performance business website for an independent contractor, focusing on SEO and clean UI/UX."
    url="/project/contractor-portfolio-platform"
  />

</BaseLayout>