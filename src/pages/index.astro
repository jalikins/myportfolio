---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there</div>
    <div class="text-5xl font-bold">I'm Jacob Likins</div>
    <div class="text-3xl py-3 font-bold">Electrical & Computing Engineering Student</div>
    <div class="py-2">
      <text class="text-lg">
        I am an ECE student at <b>Olin College of Engineering</b> (Class of 2028). I am heavily involved in <b>Olin's Formula SAE team,</b> where I co-led the <b>electrical and software design, integration, and firmware development.</b> I also have experience in software development, web design, and research in autonomous systems. I am interested in the intersection of hardware and software, and I am always looking for opportunities to learn and grow. Feel free to explore my projects and blog posts to see what I've been working on!
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="/contact"> Let's connect!</a>
      <a href="https://github.com/jalikins" target="_blank" class="btn btn-outline ml-5">
        Check out my GitHub
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Featured Projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="FSAE Hardware Architecture"
    img="/hardware/giant_block.png"
    desc="Designed and routed custom PCBs for critical electric vehicle subsystems, including the BMS, throttle, and high-voltage precharge circuits."
    url="/project/fsae-hardware"
    badge="PCB, High-Voltage, KiCad"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="FSAE Firmware Monorepo"
    img="/monorepo/big_block.png"
    desc="Architected a Bazel-based monorepo to unify firmware development, automated CAN code generation, and PCB design."
    url="/project/fsae-firmware-monorepo"
    badge="Embedded, Python, CI/CD"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Asensus Surgical Internship"
    img="/leadership/team.jpg"
    desc="Electrical engineering intern at Asensus Surgical. Worked on designing and testing PCBs and implementing firmware into system"
    url="/project/asensus-surgical-internship"
    badge="Design, Safety, Embedded"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest Updates</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>